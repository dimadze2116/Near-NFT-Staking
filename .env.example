# ── Telegram ───────────────────────────────────────────────────────────────
# Bot token from @BotFather. It also verifies the initData signature,
# so a leak lets anyone forge the identity of any user.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Private channel; access is granted on proven NFT ownership
CHANNEL_ID=-1001234567890

# Telegram ID of the administrator - the bot's admin menu is theirs only
ADMIN_TELEGRAM_ID=123456789

# ── Addresses ──────────────────────────────────────────────────────────────
# Public URL of the service; the Telegram webhook points here
WEBHOOK_URL=https://your-service.example.com
# URL of the Mini App, opened by a button in the bot
WEBAPP_URL=https://your-service.example.com/newapp.html
PORT=10000

# ── Internal API secrets ───────────────────────────────────────────────────
# Keeps /api/status and /api/stakes off the public internet
API_SECRET=generate-a-long-random-string
# Protects the service-restart endpoint
RESTART_SECRET=generate-another-long-random-string
RESTART_ENDPOINT=https://your-host.example.com/restart-hook

# ── NEAR ───────────────────────────────────────────────────────────────────
NEAR_NETWORK=mainnet
NFT_CONTRACT=nearlegion.nfts.tg
STAKING_CONTRACT=legion-staking.near
MARKETPLACE_CONTRACT=legion-marketplace.near

# ── IMPORTANT ──────────────────────────────────────────────────────────────
# There are no contract private keys here, and there must not be.
# The owner of both contracts is the contract account itself, and those
# keys are full-access: keeping one on the server would mean full control
# over the contract, not just management of the reward pool.
# Every state-changing contract operation is performed manually through
# near-cli. The bot only assembles the command, ready to paste.
