# ── Telegram ───────────────────────────────────────────────────────────────
# Токен бота от @BotFather. Используется и для проверки подписи initData,
# поэтому утечка позволяет подделать личность любого пользователя.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Приватный канал, доступ в который выдаётся по владению NFT
CHANNEL_ID=-1001234567890

# Telegram-ID администратора — ему доступно админ-меню бота
ADMIN_TELEGRAM_ID=123456789

# ── Адреса ─────────────────────────────────────────────────────────────────
# Публичный URL сервиса, на него ставится вебхук Telegram
WEBHOOK_URL=https://your-service.example.com
# URL мини-приложения, открывается кнопкой в боте
WEBAPP_URL=https://your-service.example.com/newapp.html
PORT=10000

# ── Внутренние секреты API ─────────────────────────────────────────────────
# Защищает /api/status и /api/stakes от публичного доступа
API_SECRET=generate-a-long-random-string
# Защищает эндпоинт перезапуска сервиса
RESTART_SECRET=generate-another-long-random-string
RESTART_ENDPOINT=https://your-host.example.com/restart-hook

# ── NEAR ───────────────────────────────────────────────────────────────────
NEAR_NETWORK=mainnet
NFT_CONTRACT=nearlegion.nfts.tg
STAKING_CONTRACT=legion-staking.near
MARKETPLACE_CONTRACT=legion-marketplace.near

# ── ВАЖНО ──────────────────────────────────────────────────────────────────
# Приватных ключей от контрактов здесь нет и быть не должно.
# Владелец обоих контрактов — сами контрактные аккаунты, и их ключи
# полнодоступные: хранение такого ключа на сервере означало бы полный
# контроль над контрактом, а не только управление пулом наград.
# Все операции, меняющие состояние контрактов, выполняются вручную
# через near-cli. Бот только формирует готовую команду.
